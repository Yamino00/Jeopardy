<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Il backend di sviluppo gira in HTTP su localhost e Android blocca il
         traffico in chiaro dall'API 28. Vive solo qui e in profile: la release
         resta rigida, cosi' un deploy in HTTP fallisce invece di funzionare
         per sbaglio. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
